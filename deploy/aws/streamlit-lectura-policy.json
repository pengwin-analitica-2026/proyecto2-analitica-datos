{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::pengwin-ct-050752608083",
     "Condition": {"StringLike": {"s3:prefix": ["crudos/*", "exportados/*"]}}},
    {"Effect": "Allow", "Action": "s3:GetObject",
     "Resource": ["arn:aws:s3:::pengwin-ct-050752608083/crudos/*", "arn:aws:s3:::pengwin-ct-050752608083/exportados/*"]}
  ]
}
