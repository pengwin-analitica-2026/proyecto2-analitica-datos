.venv/

.env


# Semana 11: casos exportados para el dashboard (se regeneran con src/demo_export.py)
outputs/demo/*
# Casos que lee el dashboard desplegado en Streamlit Community Cloud (CI/CD al hacer push a main)
!outputs/demo/latency.json
!outputs/demo/h8_aumm_noise01_noema_w32_e60_s42/
outputs/demo/h8_aumm_noise01_noema_w32_e60_s42/*
!outputs/demo/h8_aumm_noise01_noema_w32_e60_s42/024/
!outputs/demo/h8_aumm_noise01_noema_w32_e60_s42/044/
!outputs/demo/h8_aumm_noise01_noema_w32_e60_s42/099/
!outputs/demo/h8_aumm_noise01_noema_w32_e60_s42/039/
# predictions.npz solo sirve para --reuse en local
outputs/demo/**/predictions.npz

# Carpeta generada por deploy/build_streamlit_cloud.py
build/

# Pesos versionados: H6 (modelo final, tres semillas; la imagen de la API copia la s42) y D5
# (primera evaluación en test). Los demás .pth de la Semana 10 quedan fuera del repo.
!outputs/s10/h6_auggeo_rot35_canon_ema_w32_e60_s42.pth
!outputs/s10/h6_auggeo_rot35_canon_ema_w32_e60_s43.pth
!outputs/s10/h6_auggeo_rot35_canon_ema_w32_e60_s44.pth
!outputs/s10/d5_ema_w32_e60_s42.pth
# Modelo definitivo: H8 (sin EMA, giro en mm y aumento de ruido)
!outputs/s10/h8_aumm_noise01_noema_w32_e60_s42.pth
!outputs/s10/h8_aumm_noise01_noema_w32_e60_s43.pth
!outputs/s10/h8_aumm_noise01_noema_w32_e60_s44.pth

# Modelo int8 exportado (src/precision.py exportar): depende de la versión de torch con que se hizo;
# la imagen de la API lo genera al construirse. La calibración (calibracion_int8_h8.npz) sí se versiona.
outputs/s10/*_int8.pt

# id de la distribución de CloudFront de la página web (deploy/aws/web.sh)
deploy/aws/.web_estado

# datos de la página web corriendo en local (README, sección B)
datos_web/
